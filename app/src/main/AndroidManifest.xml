<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <permission
        android:name="com.sahl.permission.UNION"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.sahl.permission.UNION" />

    <queries>
        <package android:name="com.sahl.phone" />
        <package android:name="com.sahl.contacts" />
        <package android:name="com.sahl.messages" />
        <package android:name="com.sahl.camera" />
        <package android:name="com.sahl.gallery" />
        <package android:name="com.sahl.files" />
        <package android:name="com.sahl.adhan" />
        <package android:name="com.sahl.tools" />
        <package android:name="com.aly.sahlsync" />
        <package android:name="com.aly.trueqibla" />
        <package android:name="com.aly.sahlpdf" />
        <package android:name="com.sahl.pdf" />
        <package android:name="com.sahl.home" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Sahl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/SahlCameraViewfinder"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".SahlCrashActivity"
            android:exported="false" />

        <receiver
            android:name=".UpdateCheckReceiver"
            android:exported="false" />
    </application>
</manifest>
